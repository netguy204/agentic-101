# agentic-101 managed environment — per-cohort version pins
# Chunk: docs/chunks/onboarding_terminal_env - Managed participant terminal environment
#
# This file is the single source of truth for what the installers install.
# It is read by env/install.sh (macOS) and env/install.ps1 (Windows).
#
# HOW PINNING WORKS
#
#   <NAME>_VERSION=          empty  -> install the current version, then record
#                                     what was actually installed
#   <NAME>_VERSION=1.2.3     set    -> Windows: passed to `winget --version`, so
#                                     the pin is enforced.
#                                     macOS: Homebrew cannot install an arbitrary
#                                     past cask version, so the installer verifies
#                                     what it got and reports a mismatch. Run the
#                                     installer with --strict-versions to turn a
#                                     mismatch into a failure instead of a warning.
#
# HOW TO PIN A COHORT (pre-cohort checklist, TESTING_PHILOSOPHY.md)
#
#   1. Run env/install.sh (or install.ps1) on a clean machine of each platform.
#   2. Read ~/.agentic-101/installed-versions.txt — the installer writes the
#      exact versions it ended up with.
#   3. Copy those values into this file, bump ENV_VERSION, set COHORT, commit,
#      and tag cohort-YYYY-MM (SPEC.md, Versioning and Compatibility).
#
# Note: pi itself is NOT pinned here. The setup guide (setup/) installs pi at
# its own pinned version — see docs/chunks/onboarding_setup_guide.

# Version of this environment itself. Bump on any change to env/.
ENV_VERSION=1.0.1

# Cohort this pin set was validated for, e.g. 2026-09. Empty = not yet pinned.
COHORT=

# --- macOS (Homebrew) ---
# Terminal emulator (DEC-007). Verified in research: 1.3.1, 2026-03-13.
GHOSTTY_VERSION=
# Node.js. pi is an npm package, so Node is a hard dependency of the course.
NODE_VERSION=
# git. Present on macOS via the Xcode command line tools; installed explicitly
# so `commit` and `revert` do not depend on a Developer Tools prompt.
GIT_VERSION=

# --- Windows (winget) ---
# Verified in research: stable 1.24.11911.0, 2026-07-16. Preinstalled on
# Windows 11; the installer only installs it when it is missing.
WINDOWS_TERMINAL_VERSION=
# Git for Windows — supplies both git and the Git Bash shell pi requires
# (pi docs/windows.md).
GIT_WINDOWS_VERSION=
# Node.js LTS.
NODE_WINDOWS_VERSION=
