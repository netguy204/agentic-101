# agentic-101 setup — per-cohort pins for pi and the prescribed model
# Chunk: docs/chunks/onboarding_setup_guide - Pre-cohort setup guide and smoke test
#
# This file is the single source of truth for which pi and which model a
# cohort runs. It is read by setup/install-pi.sh and setup/bin/course-smoke-test.
#
# There are two pin files, deliberately:
#
#   env/versions.env    the managed terminal environment — Ghostty, Windows
#                       Terminal, Node, git. Owned by
#                       docs/chunks/onboarding_terminal_env.
#   setup/pins.env      pi and the model. This file.
#
# They are separate because they are enforced differently: winget and npm can
# install an exact version, Homebrew casks cannot.
#
# HOW TO RE-PIN A COHORT (see setup/PRE_COHORT_CHECKLIST.md, item 2)
#
#   1. `npm view @earendil-works/pi-coding-agent version` — is there a newer
#      pi? If so, install it and run through setup/README.md end to end
#      before adopting it.
#   2. `pi --list-models | grep openrouter` — confirm PI_MODEL is still in
#      the catalog. Model IDs do get retired.
#   3. Update the values below, set COHORT, commit, and tag cohort-YYYY-MM
#      (SPEC.md, Versioning and Compatibility).

# Cohort this pin set was validated for, e.g. 2026-09. Empty = not yet pinned.
COHORT=

# --- pi -------------------------------------------------------------------
# Exact npm version of @earendil-works/pi-coding-agent. npm enforces this
# pin exactly, on both platforms.
PI_VERSION=0.83.0

# --- the prescribed model (DEC-006) ---------------------------------------
# Every participant runs this provider and model. Participants never choose;
# the configuration shipped by install-pi.sh makes it their default.
#
# Why this one: capable enough that a first delegation succeeds on the first
# try — which is what decides whether a non-programmer believes the course
# works — without an Opus-class per-token cost across a whole cohort.
PI_PROVIDER=openrouter
PI_MODEL=anthropic/claude-sonnet-5

# off | minimal | low | medium | high | xhigh | max
PI_THINKING_LEVEL=medium

# --- the managed terminal environment -------------------------------------
# The ENV_VERSION from env/versions.env that this setup path was validated
# against. install-pi.sh warns (does not fail) when the installed environment
# reports something else.
EXPECTED_ENV_VERSION=1.0.0

# --- the practice directory ------------------------------------------------
# Created during setup, relative to the participant's home folder. Everything
# the smoke test does happens inside it, and it is where Session 2 starts.
# Must not be the home folder itself: `commit` refuses to run there.
PRACTICE_DIR=course-practice
